<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Folio Dev can see the daily Folio, to test the beta and switch apps. Not in main, so a release cannot. -->
    <queries><package android:name="com.mccal.folio" /></queries>
    <application>
        <activity
            android:name=".FoldMotionActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="Folio Fold Motion Lab"
            android:resizeableActivity="true" />
        <activity
            android:name=".FoldProbeActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="Folio Fold Probe"
            android:resizeableActivity="true" />
    </application>
</manifest>
