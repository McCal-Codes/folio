<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.BIND_APPWIDGET" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Only for Software Update (checking and downloading Folio from GitHub Releases, when you ask). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Unlock before listing hidden apps (Settings › Search & App Library). -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Lets a self-update skip the confirmation once Folio installed the current version itself (Android 12+). -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <!-- Optional: update notifications (asked for only when turned on in Software Update). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <queries>
        <package android:name="com.google.android.googlequicksearchbox" />
        <package android:name="com.google.android.apps.bard" />
        <package android:name="ai.perplexity.app.android" />
        <package android:name="com.anthropic.claude" />
        <package android:name="com.openai.chatgpt" />
        <!-- Good Lock's RegiStar, which can take over the side key (mentioned on the Side Key page). -->
        <package android:name="com.samsung.android.app.galaxyregistry" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_CALENDAR" />
        </intent>
        <intent><action android:name="android.intent.action.SHOW_ALARMS" /></intent>
        <intent><action android:name="org.adw.launcher.THEMES" /></intent>
        <intent><action android:name="com.novalauncher.THEME" /></intent>
        <intent><action android:name="com.teslacoilsw.launcher.THEME" /></intent>
        <intent><action android:name="ch.deletescape.lawnchair.ICONPACK" /></intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="com.anddoes.launcher.THEME" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="com.fede.launcher.THEME_ICONPACK" />
        </intent>
    </queries>
    <application android:label="${appLabel}" android:icon="@mipmap/ic_launcher"
        android:name=".DuoApplication"
        android:theme="@style/Theme.Duo" android:allowBackup="false" android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true">
        <property android:name="android.window.PROPERTY_ACTIVITY_EMBEDDING_SPLITS_ENABLED" android:value="true" />
        <property android:name="android.window.PROPERTY_ACTIVITY_EMBEDDING_ALLOW_SYSTEM_OVERRIDE" android:value="false" />
        <activity android:name=".DiscoverActivity" android:exported="false"
            android:theme="@style/Theme.Duo.Discover"
            android:taskAffinity="com.mccal.folio.discover" android:excludeFromRecents="true"
            android:resizeableActivity="true" />
        <activity android:name=".DiscoverFeedActivity" android:theme="@style/Theme.Duo.Discover" android:exported="false" android:resizeableActivity="true" />
        <activity android:name=".LiveDiscoverActivity" android:theme="@style/Theme.Duo.LiveDiscover"
            android:exported="false" android:resizeableActivity="true" />
        <service android:name=".DuneWallpaperService" android:label="Folio dunes"
            android:permission="android.permission.BIND_WALLPAPER" android:exported="true">
            <intent-filter><action android:name="android.service.wallpaper.WallpaperService" /></intent-filter>
            <meta-data android:name="android.service.wallpaper" android:resource="@xml/dune_wallpaper" />
        </service>
        <activity android:name=".AssistPickerActivity" android:exported="true"
            android:theme="@style/Theme.Folio.FoldBridge" android:excludeFromRecents="true"
            android:taskAffinity="com.mccal.folio.assist" android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity android:name=".FoldBridgeActivity" android:exported="false"
            android:theme="@style/Theme.Folio.FoldBridge"
            android:taskAffinity="com.mccal.folio.foldbridge" android:excludeFromRecents="true"
            android:noHistory="true" android:resizeableActivity="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|density" />
        <service android:name=".IslandListenerService" android:label="Folio island"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE" android:exported="true">
            <intent-filter><action android:name="android.service.notification.NotificationListenerService" /></intent-filter>
        </service>
        <service android:name=".SystemShadeAccessibilityService"
            android:label="@string/shade_service_label"
            android:description="@string/shade_service_description"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice"
                android:resource="@xml/system_shade_accessibility_service" />
        </service>
        <activity android:name=".MainActivity" android:exported="true"
            android:launchMode="singleTask" android:resizeableActivity="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|density"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Settings › Apps › Default apps › Home app (gear) and App info › Additional settings open Folio's settings. -->
            <intent-filter>
                <action android:name="android.intent.action.APPLICATION_PREFERENCES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- Folio as an app, like iOS Settings: its icon (in the App Library or another launcher) opens Folio's Settings. -->
        <activity-alias android:name=".FolioSettingsApp" android:targetActivity=".MainActivity" android:exported="true"
            android:label="${appLabel}" android:icon="@mipmap/ic_launcher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <!-- The Soft alternate icon (Settings › Wallpaper & Appearance › App Icon); off until chosen. -->
        <activity-alias android:name=".FolioSettingsAppSoft" android:targetActivity=".MainActivity" android:exported="true"
            android:label="${appLabel}" android:icon="@mipmap/ic_launcher_soft" android:enabled="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <!-- A minimal voice interaction service so the side key's "Digital assistant" can open Folio's picker. -->
        <service android:name=".FolioVoiceInteractionService" android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <meta-data android:name="android.voice_interaction" android:resource="@xml/folio_voice_interaction" />
            <intent-filter><action android:name="android.service.voice.VoiceInteractionService" /></intent-filter>
        </service>
        <service android:name=".FolioVoiceSessionService" android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION" />
        <service android:name=".FolioRecognitionService" android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <intent-filter><action android:name="android.speech.RecognitionService" /></intent-filter>
        </service>
        <activity-alias android:name=".FolioSettingsAppOlive" android:targetActivity=".MainActivity" android:exported="true"
            android:label="${appLabel}" android:icon="@mipmap/ic_launcher_olive" android:enabled="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <receiver android:name=".FocusScheduleReceiver" android:exported="false" />
        <receiver android:name=".SoftwareUpdateReceiver" android:exported="false" />
        <service android:name=".SoftwareUpdateJob" android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <!-- Share a theme file to Folio: it's validated here, then Home asks before applying it. SEND only, so Folio
             doesn't show up under "Open with" for every JSON file. -->
        <activity android:name=".ThemeImportActivity" android:exported="true" android:excludeFromRecents="true"
            android:theme="@style/Theme.Folio.FoldBridge" android:taskAffinity="com.mccal.folio.theme" android:noHistory="true"
            android:label="Folio Theme">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/json" />
            </intent-filter>
        </activity>
        <!-- folio://redeem?c=… from a supporter email: the code is checked on the phone, so a bad link is simply refused. -->
        <activity android:name=".RedeemActivity" android:exported="true" android:excludeFromRecents="true"
            android:theme="@style/Theme.Folio.FoldBridge" android:taskAffinity="com.mccal.folio.redeem" android:noHistory="true"
            android:label="Folio supporter code">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="folio" android:host="redeem" />
            </intent-filter>
        </activity>
        <!-- "Add to Home Screen" for widgets an app asks to pin (only delivered to the default Home app). -->
        <activity android:name=".PinWidgetActivity" android:exported="true" android:excludeFromRecents="true"
            android:theme="@style/Theme.Folio.FoldBridge" android:taskAffinity="com.mccal.folio.pin" android:noHistory="true">
            <intent-filter>
                <action android:name="android.content.pm.action.CONFIRM_PIN_APPWIDGET" />
                <action android:name="android.content.pm.action.CONFIRM_PIN_SHORTCUT" />
            </intent-filter>
        </activity>
        <!-- Opens Folio's settings from Android's screens (Accessibility gear, tile long-press, wallpaper settings). -->
        <activity android:name=".FolioSettingsActivity" android:exported="true" android:excludeFromRecents="true"
            android:noHistory="true" android:theme="@style/Theme.Folio.FoldBridge" android:label="Folio settings">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
        </activity>
        <!-- Quick Settings tiles -->
        <service android:name=".SpotlightTileService" android:exported="true" android:label="Spotlight"
            android:icon="@drawable/ic_tile_search" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
        <service android:name=".IslandTileService" android:exported="true" android:label="Island"
            android:icon="@drawable/ic_tile_island" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
        </service>
        <service android:name=".DockTileService" android:exported="true" android:label="Folio Dock"
            android:icon="@drawable/ic_tile_dock" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
        </service>
        <service android:name=".StandByTileService" android:exported="true" android:label="StandBy"
            android:icon="@drawable/ic_tile_standby" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
        </service>

        <!-- How much room Big Buttons take at the bottom, so a keyboard can stay clear of them. One number, no
             permission: Android tells no app about another app's overlay, and asking for a permission to avoid
             covering a button would be the worse trade. The authority carries the application id, so a debug build
             and a release build can sit side by side. -->
        <provider
            android:name=".ButtonsRoomProvider"
            android:authorities="${applicationId}.buttons"
            android:exported="true"
            android:grantUriPermissions="false" />

    </application>
</manifest>
