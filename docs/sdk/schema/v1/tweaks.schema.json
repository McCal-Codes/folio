{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://folio.mccal.dev/schema/v1/tweaks.schema.json",
  "title": "Folio tweak bundle",
  "type": "object",
  "required": [
    "format",
    "tweaks"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "format": {
      "const": 1
    },
    "tweaks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": [
          "id",
          "enabled"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "enum": [
              "appPanels",
              "dockMagnify",
              "notificationAppRow",
              "tintNotifications",
              "tintMedia",
              "pageEffects",
              "duet"
            ]
          },
          "enabled": {
            "type": "boolean"
          },
          "screens": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "cover": {
                "type": "boolean"
              },
              "inner": {
                "type": "boolean"
              }
            }
          },
          "options": {
            "description": "The tweak's own settings. Only Duet takes options today; Folio ignores options it does not know.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "style": {
                "enum": [
                  "iphone",
                  "duo",
                  "classic",
                  "deep",
                  "subtle",
                  "minimal"
                ]
              },
              "direction": {
                "enum": [
                  "both",
                  "opening",
                  "closing"
                ]
              },
              "intensity": {
                "type": "number",
                "minimum": 0.3,
                "maximum": 1.5
              },
              "frost": {
                "type": "number",
                "minimum": 0,
                "maximum": 2
              },
              "darkening": {
                "type": "number",
                "minimum": 0,
                "maximum": 2
              },
              "perspective": {
                "type": "number",
                "minimum": 0,
                "maximum": 1.33
              }
            }
          }
        }
      }
    }
  }
}
