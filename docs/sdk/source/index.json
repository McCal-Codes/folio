{
  "$schema": "https://folio.mccal.dev/schema/v1/index.schema.json",
  "format": 1,
  "name": "Folio",
  "description": "Folio’s own themes and tweaks. Built into the app, listed here so the Market treats them like any other package.",
  "icon": "assets/folio-icon.png",
  "issuesUrl": "https://github.com/McCal-Codes/folio/issues/new",
  "featured": [
    {
      "package": "com.mccal.folio.theme.clear",
      "label": "Theme of the week",
      "image": "assets/home-clear.webp"
    },
    {
      "package": "com.mccal.folio.cabinet",
      "label": "Built-in tweak"
    }
  ],
  "packages": [
    {
      "id": "com.mccal.folio.cabinet",
      "version": "1.0.0",
      "manifest": {
        "format": 1,
        "id": "com.mccal.folio.cabinet",
        "name": "Cabinet",
        "version": "1.0.0",
        "author": {
          "name": "Folio",
          "url": "https://github.com/McCal-Codes/folio"
        },
        "minFolio": "0.7.0",
        "section": "tweaks",
        "kind": [
          "tweakBundle"
        ],
        "permissions": [
          "tweaks"
        ],
        "screens": [
          "cover",
          "inner"
        ],
        "icon": "assets/icons/cabinet.png",
        "depiction": "depiction.json",
        "license": "MIT",
        "description": "Swipe up on an app icon for a small panel with its shortcuts, latest notifications and music controls.",
        "requires": {
          "features": [
            "tweaks.appPanels"
          ]
        }
      }
    },
